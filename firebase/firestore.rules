rules_version = '2';
// Firestore : avis, signalements de bug et statistiques anonymes de la bêta (étape 6, lots C et D).
// Les joueurs (connexion anonyme) déposent ; ils ne peuvent lire et effacer que leurs propres
// envois (bouton « Supprimer mes données »). Corentin lit tout depuis la console Firebase.
// Chaque envoi met à jour limites/<joueur> à l'heure du serveur (anti-spam) :
// un avis par minute au plus, un lot de statistiques toutes les 30 secondes au plus.
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() { return request.auth != null; }
    function a(champ) { return champ in request.resource.data; }
    function texte(champ, max) {
      return !a(champ) || (request.resource.data[champ] is string && request.resource.data[champ].size() <= max);
    }
    function liste(champ, max) {
      return !a(champ) || (request.resource.data[champ] is list && request.resource.data[champ].size() <= max);
    }
    function entier(champ, min, max) {
      return !a(champ) || (request.resource.data[champ] is int && request.resource.data[champ] >= min && request.resource.data[champ] <= max);
    }
    function booleen(champ) { return !a(champ) || request.resource.data[champ] is bool; }
    function limite(champ) {
      return getAfter(/databases/$(database)/documents/limites/$(request.auth.uid)).data[champ] == request.time;
    }
    function depot() {
      return connecte() && request.resource.data.uid == request.auth.uid && request.resource.data.envoye == request.time;
    }
    function aMoi() { return connecte() && resource.data.uid == request.auth.uid; }

    match /avis/{id} {
      allow create: if depot()
        && request.resource.data.keys().hasAll(['type', 'version', 'uid', 'envoye', 'pseudo'])
        && request.resource.data.keys().hasOnly(['type', 'version', 'uid', 'envoye', 'pseudo', 'email', 'age15',
             'note', 'prefere', 'difficile', 'difficileTexte', 'lutteur', 'sens', 'pratique', 'texte',
             'ecranJeu', 'appareil', 'ecran', 'combat'])
        && request.resource.data.type in ['avis', 'bug']
        && limite('avis')
        && texte('version', 20) && texte('pseudo', 16) && texte('email', 120) && booleen('age15')
        && entier('note', 1, 5)
        && liste('prefere', 8) && liste('difficile', 10) && texte('difficileTexte', 300)
        && texte('lutteur', 40) && texte('sens', 10) && texte('pratique', 20) && texte('texte', 1000)
        && texte('ecranJeu', 40) && texte('appareil', 300) && texte('ecran', 20) && texte('combat', 20000);
      allow read, delete: if aMoi();
    }

    match /stats/{id} {
      allow create: if depot()
        && request.resource.data.keys().hasAll(['type', 'version', 'uid', 'envoye', 'jour'])
        && request.resource.data.keys().hasOnly(['type', 'version', 'uid', 'envoye', 'jour', 'pratique',
             'mode', 'format', 'enchainement', 'auto', 'niveau', 'moi', 'moiRarete', 'adv', 'advRarete',
             'resultat', 'finPar', 'scoreMoi', 'scoreAdv', 'tours', 'duree', 'actionsMoi', 'actionsAdv',
             'evenement', 'valeur'])
        && request.resource.data.type in ['combat', 'parcours']
        && limite('stats')
        && texte('version', 20) && texte('jour', 10) && texte('pratique', 20)
        && texte('mode', 20) && texte('format', 10) && booleen('enchainement') && booleen('auto') && texte('niveau', 10)
        && texte('moi', 40) && texte('moiRarete', 12) && texte('adv', 40) && texte('advRarete', 12)
        && texte('resultat', 10) && texte('finPar', 12)
        && entier('scoreMoi', 0, 999) && entier('scoreAdv', 0, 999) && entier('tours', 0, 9999) && entier('duree', 0, 36000)
        && texte('actionsMoi', 600) && texte('actionsAdv', 600)
        && texte('evenement', 30) && texte('valeur', 40);
      allow read, delete: if aMoi();
    }

    match /limites/{joueur} {
      allow create: if connecte() && request.auth.uid == joueur
        && request.resource.data.keys().hasOnly(['avis', 'stats'])
        && request.resource.data.values().hasOnly([request.time]);
      allow update: if connecte() && request.auth.uid == joueur
        && request.resource.data.keys().hasOnly(['avis', 'stats'])
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avis'])
            && request.resource.data.avis == request.time
            && (!('avis' in resource.data) || request.time > resource.data.avis + duration.value(60, 's')))
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats'])
            && request.resource.data.stats == request.time
            && (!('stats' in resource.data) || request.time > resource.data.stats + duration.value(30, 's')))
        );
      allow read, delete: if connecte() && request.auth.uid == joueur;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
