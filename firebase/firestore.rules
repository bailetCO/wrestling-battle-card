rules_version = '2';
// Firestore : avis, signalements de bug et statistiques anonymes de la bêta (étape 6, lots C et D),
// sauvegarde en ligne des comptes joueurs (comptes/<joueur>) classements (classements/<mois>/joueurs/<joueur>, palmares/<joueur>) et parrainage (parrainages, amities).
// Les joueurs (connexion anonyme) déposent ; ils ne peuvent lire et effacer que leurs propres
// envois (bouton « Supprimer mes données »). Corentin lit tout depuis la console Firebase.
// Chaque envoi met à jour limites/<joueur> à l'heure du serveur (anti-spam) :
// un avis par minute au plus, un lot de statistiques toutes les 30 secondes au plus.
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() { return request.auth != null; }
    function a(champ) { return champ in request.resource.data; }
    function texte(champ, max) {
      return !a(champ) || (request.resource.data[champ] is string && request.resource.data[champ].size() <= max);
    }
    function liste(champ, max) {
      return !a(champ) || (request.resource.data[champ] is list && request.resource.data[champ].size() <= max);
    }
    function entier(champ, min, max) {
      return !a(champ) || (request.resource.data[champ] is int && request.resource.data[champ] >= min && request.resource.data[champ] <= max);
    }
    function booleen(champ) { return !a(champ) || request.resource.data[champ] is bool; }
    function limite(champ) {
      return getAfter(/databases/$(database)/documents/limites/$(request.auth.uid)).data[champ] == request.time;
    }
    function depot() {
      return connecte() && request.resource.data.uid == request.auth.uid && request.resource.data.envoye == request.time;
    }
    function aMoi() { return connecte() && resource.data.uid == request.auth.uid; }

    match /avis/{id} {
      allow create: if depot()
        && request.resource.data.keys().hasAll(['type', 'version', 'uid', 'envoye', 'pseudo'])
        && request.resource.data.keys().hasOnly(['type', 'version', 'uid', 'envoye', 'pseudo', 'email', 'age15',
             'note', 'prefere', 'difficile', 'difficileTexte', 'lutteur', 'sens', 'pratique', 'texte',
             'ecranJeu', 'appareil', 'ecran', 'combat'])
        && request.resource.data.type in ['avis', 'bug']
        && limite('avis')
        && texte('version', 20) && texte('pseudo', 16) && texte('email', 120) && booleen('age15')
        && entier('note', 1, 5)
        && liste('prefere', 8) && liste('difficile', 10) && texte('difficileTexte', 300)
        && texte('lutteur', 40) && texte('sens', 10) && texte('pratique', 20) && texte('texte', 1000)
        && texte('ecranJeu', 40) && texte('appareil', 300) && texte('ecran', 20) && texte('combat', 20000);
      allow read, delete: if aMoi();
    }

    match /stats/{id} {
      allow create: if depot()
        && request.resource.data.keys().hasAll(['type', 'version', 'uid', 'envoye', 'jour'])
        && request.resource.data.keys().hasOnly(['type', 'version', 'uid', 'envoye', 'jour', 'pratique',
             'mode', 'format', 'enchainement', 'auto', 'niveau', 'moi', 'moiRarete', 'adv', 'advRarete',
             'resultat', 'finPar', 'scoreMoi', 'scoreAdv', 'tours', 'duree', 'actionsMoi', 'actionsAdv',
             'evenement', 'valeur'])
        && request.resource.data.type in ['combat', 'parcours']
        && limite('stats')
        && texte('version', 20) && texte('jour', 10) && texte('pratique', 20)
        && texte('mode', 20) && texte('format', 10) && booleen('enchainement') && booleen('auto') && texte('niveau', 10)
        && texte('moi', 40) && texte('moiRarete', 12) && texte('adv', 40) && texte('advRarete', 12)
        && texte('resultat', 10) && texte('finPar', 12)
        && entier('scoreMoi', 0, 999) && entier('scoreAdv', 0, 999) && entier('tours', 0, 9999) && entier('duree', 0, 36000)
        && texte('actionsMoi', 600) && texte('actionsAdv', 600)
        && texte('evenement', 30) && texte('valeur', 40);
      allow read, delete: if aMoi();
    }

    match /limites/{joueur} {
      allow create: if connecte() && request.auth.uid == joueur
        && request.resource.data.keys().hasOnly(['avis', 'stats'])
        && request.resource.data.values().hasOnly([request.time]);
      allow update: if connecte() && request.auth.uid == joueur
        && request.resource.data.keys().hasOnly(['avis', 'stats'])
        && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['avis'])
            && request.resource.data.avis == request.time
            && (!('avis' in resource.data) || request.time > resource.data.avis + duration.value(60, 's')))
          ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stats'])
            && request.resource.data.stats == request.time
            && (!('stats' in resource.data) || request.time > resource.data.stats + duration.value(30, 's')))
        );
      allow read, delete: if connecte() && request.auth.uid == joueur;
    }

    // Comptes joueurs (27/11/2026) : la sauvegarde de la collection, comptes/<identifiant>.
    // Seul le propriétaire, connecté à un vrai compte (Google ou e-mail, pas anonyme), la lit et l'écrit.
    match /comptes/{joueur} {
      function proprietaire() {
        return connecte() && request.auth.uid == joueur && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }
      allow read, delete: if proprietaire();
      allow create, update: if proprietaire()
        && request.resource.data.keys().hasOnly(['code', 'cartes', 'medailles', 'victoires', 'etape', 'coach', 'maj'])
        && request.resource.data.code is string && request.resource.data.code.size() <= 400000
        && texte('coach', 40) && entier('cartes', 0, 1000) && entier('medailles', 0, 100000000)
        && entier('victoires', 0, 100000000) && entier('etape', 0, 1000)
        && request.resource.data.maj == request.time;
    }

    // Classements (28/11/2026, 2e version). Lecture : tout joueur connecté. Écriture : seulement sa
    // propre ligne, avec un vrai compte (Google ou e-mail). Pas d'effacement.
    // 1. Division en ligne du mois : classements/<mois>/joueurs/<identifiant>. `enLigne` = combats en
    //    ligne joués ce mois (ne fait que monter) ; `points` = score de la division. À chaque envoi, les
    //    points montent d'au plus 25 et baissent d'au plus 15 par combat en plus, et il faut au moins
    //    60 secondes par combat depuis l'envoi précédent. Novembre 2026 : anciens points acceptés.
    match /classements/{mois}/joueurs/{joueur} {
      function vraiCompte() {
        return connecte() && request.auth.uid == joueur && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }
      function nouveau() { return request.resource.data; }
      function ligneValide() {
        return mois.matches('^[0-9]{4}-[0-9]{2}$')
          && nouveau().keys().hasOnly(['idCoach', 'pseudo', 'pays', 'badge', 'points', 'enLigne', 'maj'])
          && nouveau().keys().hasAll(['idCoach', 'pseudo', 'points', 'enLigne', 'maj'])
          && texte('idCoach', 40) && texte('pseudo', 16) && texte('pays', 2) && texte('badge', 10)
          && nouveau().points is int && nouveau().points >= 0
          && nouveau().enLigne is int && nouveau().enLigne >= 0
          && nouveau().maj == request.time;
      }
      function combats() { return nouveau().enLigne - resource.data.get('enLigne', 0); }
      allow read: if connecte();
      allow create: if vraiCompte() && ligneValide()
        && nouveau().enLigne <= 30 * request.time.day()
        && (nouveau().points <= 25 * nouveau().enLigne || (mois == '2026-11' && nouveau().points <= 80 * request.time.day()));
      allow update: if vraiCompte() && ligneValide()
        && combats() >= 0
        && nouveau().points - resource.data.points <= 25 * combats()
        && resource.data.points - nouveau().points <= 15 * combats()
        && request.time >= resource.data.maj + duration.value(60 * combats(), 's');
    }

    // 2. Palmarès à vie : palmares/<identifiant>. `fort` = victoires contre l'ordinateur fort (au moins
    //    20 secondes chacune), `saison` = saisons terminées × 10 + palier (au moins 10 secondes par point).
    //    Les deux ne font que monter.
    match /palmares/{joueur} {
      function vraiCompte() {
        return connecte() && request.auth.uid == joueur && request.auth.token.firebase.sign_in_provider != 'anonymous';
      }
      function nouveau() { return request.resource.data; }
      function ligneValide() {
        return nouveau().keys().hasOnly(['idCoach', 'pseudo', 'pays', 'badge', 'fort', 'saison', 'maj'])
          && nouveau().keys().hasAll(['idCoach', 'pseudo', 'fort', 'saison', 'maj'])
          && texte('idCoach', 40) && texte('pseudo', 16) && texte('pays', 2) && texte('badge', 10)
          && nouveau().fort is int && nouveau().fort >= 0
          && nouveau().saison is int && nouveau().saison >= 0
          && nouveau().maj == request.time;
      }
      allow read: if connecte();
      allow create: if vraiCompte() && ligneValide() && nouveau().fort <= 200 && nouveau().saison <= 1000;
      allow update: if vraiCompte() && ligneValide()
        && nouveau().fort >= resource.data.fort
        && nouveau().saison >= resource.data.saison
        && request.time >= resource.data.maj + duration.value(20 * (nouveau().fort - resource.data.fort) + 10 * (nouveau().saison - resource.data.saison), 's');
    }

    // Parrainage (27/11/2026). parrainages/<filleul> : un nouveau joueur, connecté avec un vrai compte
    // (Google ou e-mail), désigne son parrain une seule fois, pour toujours (ni modification ni effacement).
    // amities/<joueur>_<ami> : un joueur qui a ouvert le lien d'un ami le prévient (sans récompense).
    // Lecture par tout joueur connecté (le parrain cherche les fiches qui le nomment).
    match /parrainages/{joueur} {
      allow read: if connecte();
      allow create: if connecte() && request.auth.uid == joueur
        && request.auth.token.firebase.sign_in_provider != 'anonymous'
        && request.resource.data.keys().hasOnly(['parrain', 'idCoach', 'pseudo', 'cree'])
        && texte('parrain', 40) && texte('idCoach', 40) && texte('pseudo', 16)
        && request.resource.data.parrain != request.resource.data.idCoach
        && request.resource.data.cree == request.time;
    }
    match /amities/{id} {
      allow read: if connecte();
      allow create: if connecte() && id == request.auth.uid + '_' + request.resource.data.vers
        && request.resource.data.keys().hasOnly(['vers', 'idCoach', 'pseudo', 'cree'])
        && texte('vers', 40) && texte('idCoach', 40) && texte('pseudo', 16)
        && request.resource.data.vers != request.resource.data.idCoach
        && request.resource.data.cree == request.time;
    }

    // Codes créateurs (28/11/2026) : createurs/<CODE>, créés par Corentin dans la console (personne
    // ne les écrit depuis le jeu). soutiens/<joueur>_<CODE> : un joueur note qu'il a entré un code.
    match /createurs/{code} {
      allow read: if connecte();
      allow write: if false;
    }
    match /soutiens/{id} {
      allow read: if false;
      allow create: if connecte() && id == request.auth.uid + '_' + request.resource.data.code
        && request.resource.data.keys().hasOnly(['code', 'idCoach', 'cree'])
        && texte('code', 20) && texte('idCoach', 40)
        && exists(/databases/$(database)/documents/createurs/$(request.resource.data.code))
        && request.resource.data.cree == request.time;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
